{"version": 2, "width": 100, "height": 32, "timestamp": 1788121860, "env": {"SHELL": "/usr/bin/fish", "TERM": "dumb"}, "title": "ifx — Deployment Explorer and live operations"}
[0.005531, "o", "\r\n#### Lab 9 — Deployment Explorer and live operations\r\n\r\n"]
[0.287909, "o", "\r\n# Read the Rust stack: typed builders emit Program IR; ifxd owns compilation and execution.\r\n"]
[1.687946, "o", "$ sed -n '1,240p' src/main.rs\r\n"]
[2.15843, "o", "use std::process::ExitCode;\r\n\r\nuse ifx_program::{Connection, emit_program};\r\n\r\nfn main() -> ExitCode {\r\n    emit_program(|stack, context| {\r\n        let base: String = context.config(\"base\")?;\r\n        let port: i64 = context.config(\"port\")?;\r\n        let version: String = context.config(\"release\")?;\r\n        let on = Connection::local();\r\n        let release = stack\r\n            .memory_value(\"release\")\r\n            .value(version.as_str())\r\n            .add()?;\r\n        let site = stack\r\n            .host_file(\"site\")\r\n            .on(on.clone())\r\n            .path(format!(\"{base}/site\"))\r\n            .directory(true)\r\n            .add()?;\r\n        let page = stack\r\n            .host_file(\"page\")\r\n            .on(on.clone())\r\n            .path(format!(\"{base}/site/index.html\"))\r\n            .content(ifx_program::concat!(\r\n                \"<h1>ifx tutorial</h1>\\n<p>release \",\r\n                release.value(),\r\n                \" is healthy</p>\\n\",\r\n            ))\r\n            .mode(\"0644\")\r\n            .depends_on(&site)\r\n            .add()?;\r\n        let metadata = stack\r\n            .host_file(\"metadata\")\r\n            .on(on.clone())\r\n            .path(format!(\"{base}/site/release.txt\"))\r\n            .content(ifx_program::concat!(release.value(), \"\\n\"))\r\n            .mode(\"0644\")\r\n            .depends_on(&site)\r\n            .add()?;\r\n        stack\r\n            .check_exec(\"files-ready\")\r\n            .on(on)\r\n            .command(format!(\r\n                \"test -s {base}/site/index.html && test -s {base}/site/release.txt\"\r\n            ))\r\n            .depends_on(&page)\r\n            .depends_on(&metadata)\r\n"]
[2.158474, "o", "            .add()?;\r\n        stack\r\n            .check_tcp(\"web-port\")\r\n            .host(\"127.0.0.1\")\r\n            .port(port)\r\n            .timeout_secs(2)\r\n            .depends_on(&page)\r\n            .add()?;\r\n        stack\r\n            .check_http(\"web-page\")\r\n            .url(format!(\"http://127.0.0.1:{port}/index.html\"))\r\n            .expect_body(format!(\"release {version}\"))\r\n            .timeout_secs(2)\r\n            .depends_on(&page)\r\n            .add()?;\r\n        Ok(())\r\n    })\r\n}\r\n"]
[2.158699, "o", "\r\n# Build immediately. Subsequent commands reuse the daemon's compiled artifact.\r\n"]
[3.559046, "o", "$ ifx build\r\n"]
[4.326346, "o", "ready generation 2 in 235 ms\r\n"]
[7.129707, "o", "\r\n# Plan observes real resources; exit 2 means changes are pending.\r\n"]
[8.529871, "o", "$ ifx plan\r\n"]
[9.1874, "o", "  + host.file:site\r\n      directory: true\r\n"]
[9.187447, "o", "      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/09/site\r\n      privileged: false\r\n      state: present\r\n  + memory.value:release\r\n      value: 2026.08\r\n"]
[9.187556, "o", "  + host.file:metadata\r\n      content: <computed>\r\n      directory: false\r\n      mode: 0644\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/09/site/release.txt\r\n      privileged: false\r\n"]
[9.187873, "o", "      state: present\r\n  + host.file:page\r\n      content: <computed>\r\n      directory: false\r\n      mode: 0644\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/09/site/index.html\r\n      privileged: false\r\n      state: present\r\n  + check.exec:files-ready\r\n      command: test -s /tmp/ifx-lab/09/site/index.html && test -s /tmp/ifx-lab/09/site/release.…\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      privileged: false\r\n      required: false\r\n      timeout_secs: 10\r\n  + check.http:web-page\r\n      expect_body: release 2026.08\r\n"]
[9.187966, "o", "      expect_status: 200\r\n      insecure: false\r\n      method: GET\r\n      required: false\r\n      timeout_secs: 2\r\n      url: http://127.0.0.1:8879/index.html\r\n  + check.tcp:web-port\r\n"]
[9.188027, "o", "      host: 127.0.0.1\r\n      port: 8879\r\n      required: false\r\n      timeout_secs: 2\r\n\r\nPlan: 7 to create, 0 to update, 0 to replace, 0 to delete, 0 triggered, 0 to adopt, 0 unchanged.\r\n"]
[11.991736, "o", "\r\n# Apply reconciles the graph in dependency order.\r\n"]
[13.391738, "o", "$ ifx apply -y\r\n"]
[14.04497, "o", "  + host.file:site\r\n      directory: true\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/09/site\r\n"]
[14.045098, "o", "      privileged: false\r\n      state: present\r\n  + memory.value:release\r\n      value: 2026.08\r\n  + host.file:metadata\r\n      content: <computed>\r\n      directory: false\r\n      mode: 0644\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/09/site/release.txt\r\n      privileged: false\r\n      state: present\r\n  + host.file:page\r\n"]
[14.045188, "o", "      content: <computed>\r\n      directory: false\r\n      mode: 0644\r\n"]
[14.045274, "o", "      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/09/site/index.html\r\n      privileged: false\r\n      state: present\r\n  + check.exec:files-ready\r\n      command: test -s /tmp/ifx-lab/09/site/index.html && test -s /tmp/ifx-lab/09/site/release.…\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      privileged: false\r\n      required: false\r\n"]
[14.045341, "o", "      timeout_secs: 10\r\n  + check.http:web-page\r\n      expect_body: release 2026.08\r\n      expect_status: 200\r\n      insecure: false\r\n"]
[14.045406, "o", "      method: GET\r\n      required: false\r\n      timeout_secs: 2\r\n      url: http://127.0.0.1:8879/index.html\r\n  + check.tcp:web-port\r\n"]
[14.045468, "o", "      host: 127.0.0.1\r\n      port: 8879\r\n      required: false\r\n      timeout_secs: 2\r\n"]
[14.045524, "o", "\r\nPlan: 7 to create, 0 to update, 0 to replace, 0 to delete, 0 triggered, 0 to adopt, 0 unchanged.\r\n\r\n"]
[14.158934, "o", "  create memory.value:release...\r\n  create host.file:site...\r\n  done memory.value:release\r\n  done host.file:site\r\n  create host.file:metadata...\r\n  create host.file:page...\r\n  done host.file:metadata\r\n  done host.file:page\r\n  create check.tcp:web-port...\r\n  create check.exec:files-ready...\r\n  create check.http:web-page...\r\n"]
[14.267891, "o", "  done check.tcp:web-port\r\n  done check.exec:files-ready\r\n  done check.http:web-page\r\n"]
[14.276683, "o", "\r\nApply complete. 7 resource(s) changed.\r\n\r\nOutputs:\r\n"]
[14.276714, "o", "  check.exec:files-ready\r\n    checked_at = 2026-08-30T20:31:14.875624652+00:00\r\n"]
[14.276735, "o", "    latency_ms = 2\r\n    message = test -s /tmp/ifx-lab/09/site/index.html && test -s /tmp/ifx-lab/09/site/release.txt\r\n    status = healthy\r\n"]
[14.276828, "o", "  check.http:web-page\r\n    checked_at = 2026-08-30T20:31:14.925179929+00:00\r\n    latency_ms = 51\r\n    message = http://127.0.0.1:8879/index.html: error sending request for url (http://127.0.0.1:8879/index.html)\r\n    status = unhealthy\r\n  check.tcp:web-port\r\n    checked_at = 2026-08-30T20:31:14.873338972+00:00\r\n    latency_ms = 0\r\n    message = 127.0.0.1:8879: Connection refused (os error 111)\r\n    status = unhealthy\r\n  host.file:metadata\r\n    exists = true\r\n"]
[14.276849, "o", "    path = /tmp/ifx-lab/09/site/release.txt\r\n    sha256 = a081f672884f4cb7584d628b253f27fc628658e4cb3cced7c41a1a867a5fa313\r\n  host.file:page\r\n    exists = true\r\n    path = /tmp/ifx-lab/09/site/index.html\r\n"]
[14.276911, "o", "    sha256 = 0cf6d20deb1919faa8c70b35e546a4a89f2947d94bd8c285f600c69e35c00cea\r\n  host.file:site\r\n    exists = true\r\n    path = /tmp/ifx-lab/09/site\r\n  memory.value:release\r\n    id = mem-f5d0-1\r\n    value = 2026.08\r\n"]
[14.276965, "o", "\r\nChecks:\r\n  ✓ check.exec:files-ready  test -s /tmp/ifx-lab/09/site/index.html && test -s /tmp/ifx-lab/09/site/release.txt (2 ms)\r\n  ✗ check.http:web-page  http://127.0.0.1:8879/index.html: error sending request for url (http://127.0.0.1:8879/index.html) (49 ms)\r\n  ✗ check.tcp:web-port  127.0.0.1:8879: Connection refused (os error 111) (0 ms)\r\n"]
[17.080226, "o", "\r\n# Start the Rust lab HTTP server, then run health checks.\r\n"]
[18.480362, "o", "$ ifx-labs serve /tmp/ifx-lab/09/site 8879 &\r\n"]
[18.987416, "o", "$ ifx check\r\n"]
[19.631554, "o", "  ✓ check.exec:files-ready  test -s /tmp/ifx-lab/09/site/index.html && test -s /tmp/ifx-lab/09/site/release.txt (3 ms)\r\n  ✓ check.http:web-page  http://127.0.0.1:8879/index.html: 200 (50 ms)\r\n  ✓ check.tcp:web-port  127.0.0.1:8879: connected (0 ms)\r\n"]
[22.434974, "o", "$ ifx graph --format html --no-refresh --out /tmp/ifx-lab/09/deployment.html\r\n"]
[25.794114, "o", "\r\n# A second plan is empty: the deployment is idempotent.\r\n"]
[27.194202, "o", "$ ifx plan\r\n"]
[27.848998, "o", "\r\nPlan: 0 to create, 0 to update, 0 to replace, 0 to delete, 0 triggered, 0 to adopt, 7 unchanged.\r\n"]
[30.65207, "o", "\r\n# Destroy removes managed resources in reverse dependency order.\r\n"]
[32.052168, "o", "$ ifx destroy -y\r\n"]
[32.69872, "o", "  - check.tcp:web-port\r\n  - check.http:web-page\r\n  - check.exec:files-ready\r\n  - host.file:page\r\n  - host.file:metadata\r\n  - memory.value:release\r\n  - host.file:site\r\n\r\nPlan: 0 to create, 0 to update, 0 to replace, 7 to delete, 0 triggered, 0 to adopt, 0 unchanged.\r\n\r\n"]
[32.811038, "o", "  delete check.tcp:web-port...\r\n  done check.tcp:web-port\r\n  delete check.http:web-page...\r\n  done check.http:web-page\r\n  delete check.exec:files-ready...\r\n  done check.exec:files-ready\r\n  delete host.file:page...\r\n  done host.file:page\r\n  delete host.file:metadata...\r\n  done host.file:metadata\r\n  delete memory.value:release...\r\n  done memory.value:release\r\n"]
[32.91972, "o", "  delete host.file:site...\r\n  done host.file:site\r\n"]
