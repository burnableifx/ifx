{"version": 2, "width": 100, "height": 32, "timestamp": 1788121715, "env": {"SHELL": "/usr/bin/fish", "TERM": "dumb"}, "title": "ifx — First stack: plan, apply, drift, state"}
[0.005308, "o", "\r\n#### Lab 1 — First stack: plan, apply, drift, state\r\n\r\n"]
[0.287424, "o", "\r\n# Read the Rust stack: typed builders emit Program IR; ifxd owns compilation and execution.\r\n"]
[1.687482, "o", "$ sed -n '1,240p' src/main.rs\r\n"]
[2.157825, "o", "use std::process::ExitCode;\r\n\r\nuse ifx_program::{Connection, emit_program};\r\n\r\nfn main() -> ExitCode {\r\n    emit_program(|stack, context| {\r\n        let base: String = context.config(\"base\")?;\r\n        let on = Connection::local();\r\n\r\n        let directory = stack\r\n            .host_file(\"dir\")\r\n            .on(on.clone())\r\n            .path(&base)\r\n            .directory(true)\r\n            .add()?;\r\n\r\n        stack\r\n            .host_file(\"greeting\")\r\n            .on(on.clone())\r\n            .path(format!(\"{base}/greeting.txt\"))\r\n            .content(\"hello from ifx\\n\")\r\n            .mode(\"0644\")\r\n            .depends_on(&directory)\r\n            .add()?;\r\n\r\n        stack\r\n            .host_file(\"secret\")\r\n            .on(on)\r\n            .path(format!(\"{base}/secret.txt\"))\r\n            .content(\"s3cret\\n\")\r\n            .mode(\"0600\")\r\n            .depends_on(&directory)\r\n            .add()?;\r\n\r\n"]
[2.157876, "o", "        Ok(())\r\n    })\r\n}\r\n"]
[2.158104, "o", "\r\n# Build immediately. Subsequent commands reuse the daemon's compiled artifact.\r\n"]
[3.558265, "o", "$ ifx build\r\n"]
[4.311281, "o", "ready generation 2 in 224 ms\r\n"]
[7.114397, "o", "\r\n# Plan observes real resources; exit 2 means changes are pending.\r\n"]
[8.514551, "o", "$ ifx plan\r\n"]
[9.169007, "o", "  + host.file:dir\r\n      directory: true\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/01\r\n      privileged: false\r\n      state: present\r\n  + host.file:greeting\r\n"]
[9.169146, "o", "      content: hello from ifx\r\n      directory: false\r\n      mode: 0644\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/01/greeting.txt\r\n      privileged: false\r\n      state: present\r\n  + host.file:secret\r\n      content: s3cret\r\n      directory: false\r\n      mode: 0600\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/01/secret.txt\r\n      privileged: false\r\n      state: present\r\n\r\nPlan: 3 to create, 0 to update, 0 to replace, 0 to delete, 0 triggered, 0 to adopt, 0 unchanged.\r\n"]
[11.9726, "o", "\r\n# Apply reconciles the graph in dependency order.\r\n"]
[13.372729, "o", "$ ifx apply -y\r\n"]
[14.029785, "o", "  + host.file:dir\r\n      directory: true\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/01\r\n      privileged: false\r\n      state: present\r\n  + host.file:greeting\r\n      content: hello from ifx\r\n      directory: false\r\n      mode: 0644\r\n"]
[14.029942, "o", "      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/01/greeting.txt\r\n      privileged: false\r\n      state: present\r\n  + host.file:secret\r\n      content: s3cret\r\n      directory: false\r\n      mode: 0600\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/01/secret.txt\r\n      privileged: false\r\n      state: present\r\n\r\nPlan: 3 to create, 0 to update, 0 to replace, 0 to delete, 0 triggered, 0 to adopt, 0 unchanged.\r\n\r\n"]
[14.143748, "o", "  create host.file:dir...\r\n  done host.file:dir\r\n  create host.file:greeting...\r\n  create host.file:secret...\r\n  done host.file:greeting\r\n  done host.file:secret\r\n"]
[14.14942, "o", "\r\nApply complete. 3 resource(s) changed.\r\n\r\nOutputs:\r\n  host.file:dir\r\n    exists = true\r\n    path = /tmp/ifx-lab/01\r\n"]
[14.149493, "o", "  host.file:greeting\r\n    exists = true\r\n    path = /tmp/ifx-lab/01/greeting.txt\r\n    sha256 = 0d6e2e6a8195b6482a901b1599b76e3b42a8884416b2442d82929be27bc83653\r\n  host.file:secret\r\n    exists = true\r\n    path = /tmp/ifx-lab/01/secret.txt\r\n    sha256 = 82ba9d712d21dc7585dd6a1f29790679985547f009baee10ea2e3edd41ce957d\r\n"]
[16.953065, "o", "\r\n# A second plan is empty: the deployment is idempotent.\r\n"]
[18.353196, "o", "$ ifx plan\r\n"]
[19.003781, "o", "\r\nPlan: 0 to create, 0 to update, 0 to replace, 0 to delete, 0 triggered, 0 to adopt, 3 unchanged.\r\n"]
[21.807242, "o", "\r\n# Destroy removes managed resources in reverse dependency order.\r\n"]
[23.207366, "o", "$ ifx destroy -y\r\n"]
[23.852991, "o", "  - host.file:secret\r\n  - host.file:greeting\r\n  - host.file:dir\r\n\r\nPlan: 0 to create, 0 to update, 0 to replace, 3 to delete, 0 triggered, 0 to adopt, 0 unchanged.\r\n\r\n"]
[23.96471, "o", "  delete host.file:secret...\r\n  done host.file:secret\r\n  delete host.file:greeting...\r\n  done host.file:greeting\r\n  delete host.file:dir...\r\n  done host.file:dir\r\n"]
[23.971023, "o", "\r\nApply complete. 3 resource(s) changed.\r\n"]
[26.79164, "o", "ifx-labs: all commands exited as expected\r\n"]
