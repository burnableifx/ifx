{"version": 2, "width": 100, "height": 32, "timestamp": 1788121801, "env": {"SHELL": "/usr/bin/fish", "TERM": "dumb"}, "title": "ifx — Health, drift, and daemon observation"}
[0.006114, "o", "\r\n#### Lab 4 — Health, drift, and daemon observation\r\n\r\n"]
[0.28852, "o", "\r\n# Read the Rust stack: typed builders emit Program IR; ifxd owns compilation and execution.\r\n"]
[1.68869, "o", "$ sed -n '1,240p' src/main.rs\r\n"]
[2.15895, "o", "use std::process::ExitCode;\r\n\r\nuse ifx_program::{Connection, emit_program};\r\n\r\nfn main() -> ExitCode {\r\n    emit_program(|stack, context| {\r\n        let base: String = context.config(\"base\")?;\r\n        let port: i64 = context.config(\"port\")?;\r\n        let on = Connection::local();\r\n        let directory = stack\r\n            .host_file(\"dir\")\r\n            .on(on.clone())\r\n            .path(&base)\r\n            .directory(true)\r\n            .add()?;\r\n        let index = stack\r\n            .host_file(\"index\")\r\n            .on(on.clone())\r\n            .path(format!(\"{base}/index.html\"))\r\n            .content(\"<h1>lab 4</h1>\\n\")\r\n            .depends_on(&directory)\r\n            .add()?;\r\n        stack\r\n            .check_exec(\"index-present\")\r\n            .on(on)\r\n            .command(format!(\"test -s {base}/index.html\"))\r\n            .depends_on(&index)\r\n            .add()?;\r\n        stack\r\n            .check_tcp(\"web-port\")\r\n            .host(\"127.0.0.1\")\r\n            .port(port)\r\n            .timeout_secs(2)\r\n            .depends_on(&index)\r\n            .add()?;\r\n        stack\r\n            .check_http(\"web-http\")\r\n            .url(format!(\"http://127.0.0.1:{port}/index.html\"))\r\n            .expect_body(\"lab 4\")\r\n            .timeout_secs(2)\r\n            .depends_on(&index)\r\n            .add()?;\r\n        Ok(())\r\n    })\r\n}\r\n"]
[2.159269, "o", "\r\n# Build immediately. Subsequent commands reuse the daemon's compiled artifact.\r\n"]
[3.559409, "o", "$ ifx build\r\n"]
[4.319194, "o", "ready generation 2 in 231 ms\r\n"]
[7.122684, "o", "\r\n# Plan observes real resources; exit 2 means changes are pending.\r\n"]
[8.522792, "o", "$ ifx plan\r\n"]
[9.178159, "o", "  + host.file:dir\r\n      directory: true\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n"]
[9.17823, "o", "      path: /tmp/ifx-lab/04\r\n      privileged: false\r\n      state: present\r\n  + host.file:index\r\n      content: <h1>lab 4</h1>\r\n      directory: false\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n"]
[9.178287, "o", "      path: /tmp/ifx-lab/04/index.html\r\n      privileged: false\r\n      state: present\r\n  + check.exec:index-present\r\n"]
[9.178475, "o", "      command: test -s /tmp/ifx-lab/04/index.html\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      privileged: false\r\n      required: false\r\n      timeout_secs: 10\r\n  + check.http:web-http\r\n      expect_body: lab 4\r\n      expect_status: 200\r\n      insecure: false\r\n      method: GET\r\n      required: false\r\n      timeout_secs: 2\r\n"]
[9.178527, "o", "      url: http://127.0.0.1:8765/index.html\r\n  + check.tcp:web-port\r\n      host: 127.0.0.1\r\n      port: 8765\r\n      required: false\r\n"]
[9.178568, "o", "      timeout_secs: 2\r\n\r\nPlan: 5 to create, 0 to update, 0 to replace, 0 to delete, 0 triggered, 0 to adopt, 0 unchanged.\r\n"]
[11.98208, "o", "\r\n# Apply reconciles the graph in dependency order.\r\n"]
[13.382273, "o", "$ ifx apply -y\r\n"]
[14.032902, "o", "  + host.file:dir\r\n      directory: true\r\n"]
[14.03295, "o", "      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/04\r\n      privileged: false\r\n      state: present\r\n  + host.file:index\r\n      content: <h1>lab 4</h1>\r\n      directory: false\r\n"]
[14.032969, "o", "      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/04/index.html\r\n"]
[14.032986, "o", "      privileged: false\r\n      state: present\r\n  + check.exec:index-present\r\n"]
[14.033006, "o", "      command: test -s /tmp/ifx-lab/04/index.html\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n"]
[14.033194, "o", "      privileged: false\r\n      required: false\r\n      timeout_secs: 10\r\n  + check.http:web-http\r\n"]
[14.033254, "o", "      expect_body: lab 4\r\n      expect_status: 200\r\n      insecure: false\r\n      method: GET\r\n      required: false\r\n      timeout_secs: 2\r\n      url: http://127.0.0.1:8765/index.html\r\n  + check.tcp:web-port\r\n      host: 127.0.0.1\r\n      port: 8765\r\n      required: false\r\n      timeout_secs: 2\r\n\r\nPlan: 5 to create, 0 to update, 0 to replace, 0 to delete, 0 triggered, 0 to adopt, 0 unchanged.\r\n\r\n"]
[14.146216, "o", "  create host.file:dir...\r\n  done host.file:dir\r\n  create host.file:index...\r\n  done host.file:index\r\n  create check.exec:index-present...\r\n  create check.tcp:web-port...\r\n  create check.http:web-http...\r\n  done check.tcp:web-port\r\n  done check.exec:index-present\r\n  done check.http:web-http\r\n"]
[14.263419, "o", "\r\nApply complete. 5 resource(s) changed.\r\n\r\nOutputs:\r\n  check.exec:index-present\r\n    checked_at = 2026-08-30T20:30:15.445298888+00:00\r\n    latency_ms = 2\r\n    message = test -s /tmp/ifx-lab/04/index.html\r\n    status = healthy\r\n  check.http:web-http\r\n    checked_at = 2026-08-30T20:30:15.495018260+00:00\r\n    latency_ms = 51\r\n    message = http://127.0.0.1:8765/index.html: error sending request for url (http://127.0.0.1:8765/index.html)\r\n    status = unhealthy\r\n  check.tcp:web-port\r\n    checked_at = 2026-08-30T20:30:15.443032196+00:00\r\n    latency_ms = 0\r\n    message = 127.0.0.1:8765: Connection refused (os error 111)\r\n    status = unhealthy\r\n  host.file:dir\r\n    exists = true\r\n    path = /tmp/ifx-lab/04\r\n  host.file:index\r\n    exists = true\r\n"]
[14.263483, "o", "    path = /tmp/ifx-lab/04/index.html\r\n    sha256 = 26852c15162a68c62838469dc4003122b8688c2cf6963a66bb0290f78db0e59e\r\n\r\nChecks:\r\n  ✓ check.exec:index-present  test -s /tmp/ifx-lab/04/index.html (3 ms)\r\n  ✗ check.http:web-http  http://127.0.0.1:8765/index.html: error sending request for url (http://127.0.0.1:8765/index.html) (50 ms)\r\n  ✗ check.tcp:web-port  127.0.0.1:8765: Connection refused (os error 111) (0 ms)\r\n"]
[17.066908, "o", "\r\n# Start the Rust lab HTTP server, then run health checks.\r\n"]
[18.466956, "o", "$ ifx-labs serve /tmp/ifx-lab/04 8765 &\r\n"]
[18.97465, "o", "$ ifx check\r\n"]
[19.616238, "o", "  ✓ check.exec:index-present  test -s /tmp/ifx-lab/04/index.html (2 ms)\r\n  ✓ check.http:web-http  http://127.0.0.1:8765/index.html: 200 (50 ms)\r\n  ✓ check.tcp:web-port  127.0.0.1:8765: connected (0 ms)\r\n"]
[22.419868, "o", "\r\n# A second plan is empty: the deployment is idempotent.\r\n"]
[23.82003, "o", "$ ifx plan\r\n"]
[24.469946, "o", "\r\nPlan: 0 to create, 0 to update, 0 to replace, 0 to delete, 0 triggered, 0 to adopt, 5 unchanged.\r\n"]
[27.273461, "o", "\r\n# Destroy removes managed resources in reverse dependency order.\r\n"]
[28.673489, "o", "$ ifx destroy -y\r\n"]
[29.319885, "o", "  - check.tcp:web-port\r\n  - check.http:web-http\r\n  - check.exec:index-present\r\n  - host.file:index\r\n  - host.file:dir\r\n\r\nPlan: 0 to create, 0 to update, 0 to replace, 5 to delete, 0 triggered, 0 to adopt, 0 unchanged.\r\n\r\n"]
[29.435092, "o", "  delete check.tcp:web-port...\r\n  done check.tcp:web-port\r\n  delete check.http:web-http...\r\n  done check.http:web-http\r\n  delete check.exec:index-present...\r\n  done check.exec:index-present\r\n  delete host.file:index...\r\n  done host.file:index\r\n  delete host.file:dir...\r\n  done host.file:dir\r\n"]
[29.442204, "o", "\r\nApply complete. 5 resource(s) changed.\r\n"]
