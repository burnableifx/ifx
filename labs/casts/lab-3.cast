{"version": 2, "width": 100, "height": 32, "timestamp": 1788121769, "env": {"SHELL": "/usr/bin/fish", "TERM": "dumb"}, "title": "ifx — Lifecycle: triggers, guards, and protection"}
[0.005844, "o", "\r\n#### Lab 3 — Lifecycle: triggers, guards, and protection\r\n\r\n"]
[0.328364, "o", "\r\n# Read the Rust stack: typed builders emit Program IR; ifxd owns compilation and execution.\r\n"]
[1.728462, "o", "$ sed -n '1,240p' src/main.rs\r\n"]
[2.198719, "o", "use std::process::ExitCode;\r\n\r\nuse ifx_program::{Connection, emit_program};\r\n\r\nfn main() -> ExitCode {\r\n    emit_program(|stack, context| {\r\n        let base: String = context.config(\"base\")?;\r\n        let protect: bool = context.config_optional(\"protect\")?.unwrap_or(true);\r\n        let on = Connection::local();\r\n        let directory = stack\r\n            .host_file(\"dir\")\r\n            .on(on.clone())\r\n            .path(&base)\r\n            .directory(true)\r\n            .add()?;\r\n        let app = stack\r\n            .host_file(\"app-config\")\r\n            .on(on.clone())\r\n            .path(format!(\"{base}/app.conf\"))\r\n            .content(\"workers = 2\\n\")\r\n            .depends_on(&directory)\r\n            .add()?;\r\n        stack\r\n            .host_exec(\"init\")\r\n            .on(on.clone())\r\n            .command(format!(\"echo initialised > {base}/init.done\"))\r\n            .creates(format!(\"{base}/init.done\"))\r\n            .depends_on(&directory)\r\n            .add()?;\r\n        stack\r\n            .host_exec(\"reload\")\r\n            .on(on.clone())\r\n            .command(format!(\"date +%s >> {base}/reloads.log\"))\r\n            .triggered_by(&app)\r\n            .add()?;\r\n        let keep = stack\r\n            .host_file(\"keep\")\r\n            .on(on)\r\n            .path(format!(\"{base}/keep.txt\"))\r\n            .content(\"do not lose me\\n\")\r\n            .depends_on(&directory);\r\n        if protect {\r\n            keep.protect().add()?;\r\n        } else {\r\n            keep.add()?;\r\n        }\r\n        Ok(())\r\n    })\r\n}\r\n"]
[2.198882, "o", "\r\n# Build immediately. Subsequent commands reuse the daemon's compiled artifact.\r\n"]
[3.59907, "o", "$ ifx build\r\n"]
[4.361242, "o", "ready generation 2 in 233 ms\r\n"]
[7.164692, "o", "\r\n# Plan observes real resources; exit 2 means changes are pending.\r\n"]
[8.56479, "o", "$ ifx plan\r\n"]
[9.21817, "o", "  + host.file:dir\r\n      directory: true\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/03\r\n      privileged: false\r\n      state: present\r\n  + host.exec:init\r\n      command: echo initialised > /tmp/ifx-lab/03/init.done\r\n      creates: /tmp/ifx-lab/03/init.done\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      privileged: false\r\n  + host.file:app-config\r\n"]
[9.218253, "o", "      content: workers = 2\r\n      directory: false\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/03/app.conf\r\n      privileged: false\r\n      state: present\r\n  + host.exec:reload\r\n      command: date +%s >> /tmp/ifx-lab/03/reloads.log\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      privileged: false\r\n  + host.file:keep\r\n      content: do not lose me\r\n      directory: false\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/03/keep.txt\r\n      privileged: false\r\n"]
[9.21846, "o", "      state: present\r\n\r\nPlan: 5 to create, 0 to update, 0 to replace, 0 to delete, 0 triggered, 0 to adopt, 0 unchanged.\r\n"]
[12.02211, "o", "\r\n# Apply reconciles the graph in dependency order.\r\n"]
[13.42222, "o", "$ ifx apply -y\r\n"]
[14.079313, "o", "  + host.file:dir\r\n      directory: true\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/03\r\n"]
[14.079445, "o", "      privileged: false\r\n      state: present\r\n  + host.exec:init\r\n      command: echo initialised > /tmp/ifx-lab/03/init.done\r\n      creates: /tmp/ifx-lab/03/init.done\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      privileged: false\r\n  + host.file:app-config\r\n      content: workers = 2\r\n"]
[14.079521, "o", "      directory: false\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/03/app.conf\r\n      privileged: false\r\n      state: present\r\n  + host.exec:reload\r\n      command: date +%s >> /tmp/ifx-lab/03/reloads.log\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      privileged: false\r\n  + host.file:keep\r\n"]
[14.079591, "o", "      content: do not lose me\r\n      directory: false\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/03/keep.txt\r\n"]
[14.079663, "o", "      privileged: false\r\n      state: present\r\n\r\nPlan: 5 to create, 0 to update, 0 to replace, 0 to delete, 0 triggered, 0 to adopt, 0 unchanged.\r\n\r\n"]
[14.195152, "o", "  create host.file:dir...\r\n  done host.file:dir\r\n  create host.exec:init...\r\n  create host.file:app-config...\r\n  create host.file:keep...\r\n  done host.exec:init\r\n  done host.file:app-config\r\n  create host.exec:reload...\r\n  done host.file:keep\r\n  done host.exec:reload\r\n"]
[14.20347, "o", "\r\nApply complete. 5 resource(s) changed.\r\n\r\nOutputs:\r\n"]
[14.203493, "o", "  host.exec:init\r\n    ran_at = 2026-08-30T20:29:43Z\r\n    status = 0\r\n"]
[14.203577, "o", "    stderr = \r\n    stdout = \r\n"]
[14.203668, "o", "  host.exec:reload\r\n    ran_at = 2026-08-30T20:29:43Z\r\n    status = 0\r\n    stderr = \r\n    stdout = \r\n  host.file:app-config\r\n    exists = true\r\n    path = /tmp/ifx-lab/03/app.conf\r\n    sha256 = 27a12c6c0ef423a0a0c5b7d34c9fafacfe6af084f707588cf604cf4814dbf2d5\r\n  host.file:dir\r\n    exists = true\r\n    path = /tmp/ifx-lab/03\r\n  host.file:keep\r\n    exists = true\r\n    path = /tmp/ifx-lab/03/keep.txt\r\n    sha256 = f4484e214e0bcce947946c62ca5d0a0dfa03c033689090186fa2bea6996553ee\r\n"]
[17.007311, "o", "\r\n# A second plan is empty: the deployment is idempotent.\r\n"]
[18.407598, "o", "$ ifx plan\r\n"]
[19.05647, "o", "\r\nPlan: 0 to create, 0 to update, 0 to replace, 0 to delete, 0 triggered, 0 to adopt, 5 unchanged.\r\n"]
[21.859811, "o", "\r\n# Record an unprotected revision before the state-only destroy.\r\n"]
[23.259976, "o", "$ ifx apply -y -c protect=false\r\n"]
[23.913957, "o", "  ~ host.file:keep\r\n      protect: true -> false\r\n\r\nPlan: 0 to create, 1 to update, 0 to replace, 0 to delete, 0 triggered, 0 to adopt, 4 unchanged.\r\n\r\n"]
[24.036448, "o", "\r\nApply complete. 1 resource(s) changed.\r\n\r\nOutputs:\r\n  host.exec:init\r\n    ran_at = 2026-08-30T20:29:43Z\r\n"]
[24.036523, "o", "  host.exec:reload\r\n    ran_at = 2026-08-30T20:29:43Z\r\n  host.file:app-config\r\n    exists = true\r\n    path = /tmp/ifx-lab/03/app.conf\r\n    sha256 = 27a12c6c0ef423a0a0c5b7d34c9fafacfe6af084f707588cf604cf4814dbf2d5\r\n  host.file:dir\r\n    exists = true\r\n    path = /tmp/ifx-lab/03\r\n  host.file:keep\r\n    exists = true\r\n    path = /tmp/ifx-lab/03/keep.txt\r\n"]
[24.036686, "o", "    sha256 = f4484e214e0bcce947946c62ca5d0a0dfa03c033689090186fa2bea6996553ee\r\n"]
[26.840519, "o", "\r\n# Destroy removes managed resources in reverse dependency order.\r\n"]
[28.240629, "o", "$ ifx destroy -y\r\n"]
[28.887295, "o", "  - host.file:keep\r\n  - host.exec:reload\r\n  - host.file:app-config\r\n  - host.exec:init\r\n  - host.file:dir\r\n\r\nPlan: 0 to create, 0 to update, 0 to replace, 5 to delete, 0 triggered, 0 to adopt, 0 unchanged.\r\n\r\n"]
[28.999773, "o", "  delete host.file:keep...\r\n  done host.file:keep\r\n  delete host.exec:reload...\r\n  done host.exec:reload\r\n  delete host.file:app-config...\r\n  done host.file:app-config\r\n  delete host.exec:init...\r\n  done host.exec:init\r\n  delete host.file:dir...\r\n  done host.file:dir\r\n"]
[29.006211, "o", "\r\nApply complete. 5 resource(s) changed.\r\n"]
[31.827023, "o", "ifx-labs: all commands exited as expected\r\n"]
