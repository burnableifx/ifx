{"version": 2, "width": 100, "height": 32, "timestamp": 1788121742, "env": {"SHELL": "/usr/bin/fish", "TERM": "dumb"}, "title": "ifx — References, loops, components, and targets"}
[0.005678, "o", "\r\n#### Lab 2 — References, loops, components, and targets\r\n\r\n"]
[0.288296, "o", "\r\n# Read the Rust stack: typed builders emit Program IR; ifxd owns compilation and execution.\r\n"]
[1.688415, "o", "$ sed -n '1,240p' src/main.rs\r\n"]
[2.158677, "o", "use std::process::ExitCode;\r\n\r\nuse ifx_program::memory;\r\nuse ifx_program::{Connection, Handle, IntoConcatPart as _, Stack, emit_program};\r\nuse serde_json::json;\r\n\r\nfn node(\r\n    stack: &mut Stack,\r\n    index: usize,\r\n    base: &str,\r\n    registry: &Handle<memory::Value>,\r\n) -> anyhow::Result<Handle<memory::Value>> {\r\n    let vm = stack\r\n        .memory_value(format!(\"vm-{index}\"))\r\n        .value(json!({\"name\": format!(\"node-{index}\"), \"port\": 8000 + index}))\r\n        .add()?;\r\n    let content = ifx_program::concat!(\r\n        \"id=\",\r\n        vm.id(),\r\n        \"\\nport=\",\r\n        vm.value().select::<i64>(\"port\")?,\r\n        \"\\nregistry=\",\r\n        registry.value(),\r\n        \"\\n\",\r\n    );\r\n    stack\r\n        .host_file(format!(\"cfg-{index}\"))\r\n        .on(Connection::local())\r\n        .path(format!(\"{base}/node-{index}.conf\"))\r\n        .content(content)\r\n        .add()?;\r\n    Ok(vm)\r\n}\r\n\r\nfn main() -> ExitCode {\r\n    emit_program(|stack, context| {\r\n        let base: String = context.config(\"base\")?;\r\n        let nodes: usize = context.config_optional(\"nodes\")?.unwrap_or(2);\r\n        let directory = stack\r\n            .host_file(\"dir\")\r\n            .on(Connection::local())\r\n            .path(&base)\r\n            .directory(true)\r\n            .add()?;\r\n"]
[2.158806, "o", "        let registry = stack\r\n            .memory_value(\"registry\")\r\n            .value(\"registry.internal:5000\")\r\n            .add()?;\r\n        let vms = (0..nodes)\r\n            .map(|index| node(stack, index, &base, &registry))\r\n            .collect::<anyhow::Result<Vec<_>>>()?;\r\n\r\n        let mut inventory = Vec::new();\r\n        for vm in &vms {\r\n            inventory.push(vm.id().into_concat_part()?);\r\n            inventory.push(\"\\n\".into_concat_part()?);\r\n        }\r\n        stack\r\n            .host_file(\"inventory\")\r\n            .on(Connection::local())\r\n            .path(format!(\"{base}/inventory.txt\"))\r\n            .content(ifx_program::stack::concat(inventory))\r\n            .depends_on(&directory)\r\n            .add()?;\r\n        Ok(())\r\n    })\r\n}\r\n"]
[2.159166, "o", "\r\n# Build immediately. Subsequent commands reuse the daemon's compiled artifact.\r\n"]
[3.559244, "o", "$ ifx build\r\n"]
[4.332914, "o", "ready generation 2 in 244 ms\r\n"]
[7.136292, "o", "\r\n# Plan observes real resources; exit 2 means changes are pending.\r\n"]
[8.536301, "o", "$ ifx plan\r\n"]
[9.190795, "o", "  + host.file:dir\r\n      directory: true\r\n"]
[9.190835, "o", "      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/02\r\n      privileged: false\r\n"]
[9.190942, "o", "      state: present\r\n  + memory.value:registry\r\n"]
[9.191205, "o", "      value: registry.internal:5000\r\n  + memory.value:vm-0\r\n      value: {\"name\":\"node-0\",\"port\":8000}\r\n  + host.file:cfg-0\r\n      content: <computed>\r\n      directory: false\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/02/node-0.conf\r\n"]
[9.191284, "o", "      privileged: false\r\n      state: present\r\n  + memory.value:vm-1\r\n      value: {\"name\":\"node-1\",\"port\":8001}\r\n  + host.file:cfg-1\r\n      content: <computed>\r\n      directory: false\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/02/node-1.conf\r\n      privileged: false\r\n      state: present\r\n  + memory.value:vm-2\r\n      value: {\"name\":\"node-2\",\"port\":8002}\r\n  + host.file:cfg-2\r\n      content: <computed>\r\n      directory: false\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/02/node-2.conf\r\n      privileged: false\r\n      state: present\r\n  + host.file:inventory\r\n      content: <computed>\r\n      directory: false\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n"]
[9.191331, "o", "      path: /tmp/ifx-lab/02/inventory.txt\r\n      privileged: false\r\n      state: present\r\n"]
[9.191469, "o", "\r\nPlan: 9 to create, 0 to update, 0 to replace, 0 to delete, 0 triggered, 0 to adopt, 0 unchanged.\r\n"]
[11.995395, "o", "\r\n# Apply reconciles the graph in dependency order.\r\n"]
[13.39547, "o", "$ ifx apply -y\r\n"]
[14.050253, "o", "  + host.file:dir\r\n      directory: true\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/02\r\n"]
[14.050417, "o", "      privileged: false\r\n      state: present\r\n  + memory.value:registry\r\n      value: registry.internal:5000\r\n  + memory.value:vm-0\r\n      value: {\"name\":\"node-0\",\"port\":8000}\r\n  + host.file:cfg-0\r\n"]
[14.050464, "o", "      content: <computed>\r\n      directory: false\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/02/node-0.conf\r\n      privileged: false\r\n      state: present\r\n  + memory.value:vm-1\r\n      value: {\"name\":\"node-1\",\"port\":8001}\r\n  + host.file:cfg-1\r\n      content: <computed>\r\n      directory: false\r\n"]
[14.05053, "o", "      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/02/node-1.conf\r\n      privileged: false\r\n"]
[14.050659, "o", "      state: present\r\n  + memory.value:vm-2\r\n      value: {\"name\":\"node-2\",\"port\":8002}\r\n  + host.file:cfg-2\r\n      content: <computed>\r\n      directory: false\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/02/node-2.conf\r\n      privileged: false\r\n      state: present\r\n  + host.file:inventory\r\n"]
[14.0507, "o", "      content: <computed>\r\n      directory: false\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n"]
[14.050791, "o", "      path: /tmp/ifx-lab/02/inventory.txt\r\n      privileged: false\r\n      state: present\r\n\r\nPlan: 9 to create, 0 to update, 0 to replace, 0 to delete, 0 triggered, 0 to adopt, 0 unchanged.\r\n\r\n"]
[14.165244, "o", "  create memory.value:vm-2...\r\n  create memory.value:vm-1...\r\n  create memory.value:vm-0...\r\n  create memory.value:registry...\r\n  create host.file:dir...\r\n  done memory.value:vm-2\r\n  done memory.value:vm-1\r\n  done memory.value:vm-0\r\n  done memory.value:registry\r\n  done host.file:dir\r\n  create host.file:cfg-2...\r\n  create host.file:cfg-0...\r\n  create host.file:inventory...\r\n  create host.file:cfg-1...\r\n  done host.file:cfg-2\r\n  done host.file:inventory\r\n  done host.file:cfg-1\r\n  done host.file:cfg-0\r\n"]
[14.17602, "o", "\r\nApply complete. 9 resource(s) changed.\r\n\r\nOutputs:\r\n  host.file:cfg-0\r\n    exists = true\r\n    path = /tmp/ifx-lab/02/node-0.conf\r\n    sha256 = 5578f173772957e981b4e6d9fa8ea026b0d0a47f6d1b61c6c0c048465a03afe1\r\n  host.file:cfg-1\r\n    exists = true\r\n    path = /tmp/ifx-lab/02/node-1.conf\r\n    sha256 = b0249c76de89e4a17c4fc9de8aae3194ec4a25625b8b5154b9cc6c6837a80323\r\n"]
[14.17608, "o", "  host.file:cfg-2\r\n    exists = true\r\n    path = /tmp/ifx-lab/02/node-2.conf\r\n    sha256 = 38db107a1917e74354398134d6b8b9e64ea739dd47dd81e83a31e227d12df507\r\n  host.file:dir\r\n    exists = true\r\n    path = /tmp/ifx-lab/02\r\n  host.file:inventory\r\n    exists = true\r\n    path = /tmp/ifx-lab/02/inventory.txt\r\n    sha256 = 945cfa7e81d70ae031f4664fc677d12dd9faed8f925eb364748024a5f59f3f31\r\n  memory.value:registry\r\n    id = mem-9c6d-4\r\n    value = registry.internal:5000\r\n  memory.value:vm-0\r\n    id = mem-601c-3\r\n    value = {\"name\":\"node-0\",\"port\":8000}\r\n  memory.value:vm-1\r\n    id = mem-828b-2\r\n    value = {\"name\":\"node-1\",\"port\":8001}\r\n  memory.value:vm-2\r\n    id = mem-47b0-1\r\n    value = {\"name\":\"node-2\",\"port\":8002}\r\n"]
[16.980005, "o", "\r\n# A second plan is empty: the deployment is idempotent.\r\n"]
[18.380041, "o", "$ ifx plan\r\n"]
[19.033656, "o", "\r\nPlan: 0 to create, 0 to update, 0 to replace, 0 to delete, 0 triggered, 0 to adopt, 9 unchanged.\r\n"]
[21.836987, "o", "\r\n# Destroy removes managed resources in reverse dependency order.\r\n"]
[23.23719, "o", "$ ifx destroy -y\r\n"]
[23.884786, "o", "  - host.file:inventory\r\n  - host.file:cfg-2\r\n  - memory.value:vm-2\r\n  - host.file:cfg-1\r\n  - memory.value:vm-1\r\n  - host.file:cfg-0\r\n  - memory.value:vm-0\r\n  - memory.value:registry\r\n  - host.file:dir\r\n\r\nPlan: 0 to create, 0 to update, 0 to replace, 9 to delete, 0 triggered, 0 to adopt, 0 unchanged.\r\n\r\n"]
