{"version": 2, "width": 100, "height": 32, "timestamp": 1788121833, "env": {"SHELL": "/usr/bin/fish", "TERM": "dumb"}, "title": "ifx — Reusable Rust components and typed outputs"}
[0.005851, "o", "\r\n#### Lab 5 — Reusable Rust components and typed outputs\r\n\r\n"]
[0.247626, "o", "\r\n# Read the Rust stack: typed builders emit Program IR; ifxd owns compilation and execution.\r\n"]
[1.647819, "o", "$ sed -n '1,240p' src/main.rs\r\n"]
[2.118385, "o", "use std::process::ExitCode;\r\n\r\nuse ifx_program::memory;\r\nuse ifx_program::{Connection, Handle, IntoConcatPart as _, Stack, emit_program};\r\nuse serde_json::json;\r\n\r\nfn declare_node(\r\n    stack: &mut Stack,\r\n    index: usize,\r\n    base: &str,\r\n    registry: &Handle<memory::Value>,\r\n) -> anyhow::Result<Handle<memory::Value>> {\r\n    let node = stack\r\n        .memory_value(format!(\"vm-{index}\"))\r\n        .value(json!({\"name\": format!(\"node-{index}\"), \"port\": 8000 + index}))\r\n        .add()?;\r\n    let content = ifx_program::concat!(\r\n        \"id=\",\r\n        node.id(),\r\n        \"\\nport=\",\r\n        node.value().select::<i64>(\"port\")?,\r\n        \"\\nregistry=\",\r\n        registry.value(),\r\n        \"\\n\",\r\n    );\r\n    stack\r\n        .host_file(format!(\"cfg-{index}\"))\r\n        .on(Connection::local())\r\n        .path(format!(\"{base}/node-{index}.conf\"))\r\n        .content(content)\r\n        .add()?;\r\n    Ok(node)\r\n}\r\n\r\nfn main() -> ExitCode {\r\n    emit_program(|stack, context| {\r\n        let base: String = context.config(\"base\")?;\r\n        let nodes: usize = context.config_optional(\"nodes\")?.unwrap_or(2);\r\n        let directory = stack\r\n            .host_file(\"dir\")\r\n            .on(Connection::local())\r\n            .path(&base)\r\n            .directory(true)\r\n            .add()?;\r\n        let registry = stack\r\n            .memory_value(\"registry\")\r\n            .value(\"registry.internal:5000\")\r\n            .add()?;\r\n        let nodes = (0..nodes)\r\n            .map(|index| declare_node(stack, index, &base, &registry))\r\n            .collect::<anyhow::Result<Vec<_>>>()?;\r\n        let mut inventory = Vec::new();\r\n        for node in &nodes {\r\n"]
[2.118427, "o", "            inventory.push(node.id().into_concat_part()?);\r\n            inventory.push(\"\\n\".into_concat_part()?);\r\n        }\r\n        stack\r\n            .host_file(\"inventory\")\r\n            .on(Connection::local())\r\n            .path(format!(\"{base}/inventory.txt\"))\r\n            .content(ifx_program::stack::concat(inventory))\r\n            .depends_on(&directory)\r\n            .add()?;\r\n        Ok(())\r\n    })\r\n}\r\n"]
[2.118669, "o", "\r\n# Build immediately. Subsequent commands reuse the daemon's compiled artifact.\r\n"]
[3.518816, "o", "$ ifx build\r\n"]
[4.292373, "o", "ready generation 2 in 243 ms\r\n"]
[7.095911, "o", "\r\n# Plan observes real resources; exit 2 means changes are pending.\r\n"]
[8.49592, "o", "$ ifx plan\r\n"]
[9.148611, "o", "  + host.file:dir\r\n      directory: true\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n"]
[9.148762, "o", "      path: /tmp/ifx-lab/05\r\n      privileged: false\r\n      state: present\r\n  + memory.value:registry\r\n      value: registry.internal:5000\r\n  + memory.value:vm-0\r\n      value: {\"name\":\"node-0\",\"port\":8000}\r\n  + host.file:cfg-0\r\n      content: <computed>\r\n      directory: false\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/05/node-0.conf\r\n      privileged: false\r\n"]
[9.148873, "o", "      state: present\r\n  + memory.value:vm-1\r\n      value: {\"name\":\"node-1\",\"port\":8001}\r\n  + host.file:cfg-1\r\n      content: <computed>\r\n      directory: false\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/05/node-1.conf\r\n      privileged: false\r\n      state: present\r\n  + host.file:inventory\r\n      content: <computed>\r\n      directory: false\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/05/inventory.txt\r\n      privileged: false\r\n      state: present\r\n\r\nPlan: 7 to create, 0 to update, 0 to replace, 0 to delete, 0 triggered, 0 to adopt, 0 unchanged.\r\n"]
[11.952581, "o", "\r\n# Apply reconciles the graph in dependency order.\r\n"]
[13.352684, "o", "$ ifx apply -y\r\n"]
[14.003279, "o", "  + host.file:dir\r\n      directory: true\r\n"]
[14.003318, "o", "      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/05\r\n      privileged: false\r\n      state: present\r\n  + memory.value:registry\r\n      value: registry.internal:5000\r\n  + memory.value:vm-0\r\n      value: {\"name\":\"node-0\",\"port\":8000}\r\n  + host.file:cfg-0\r\n      content: <computed>\r\n      directory: false\r\n"]
[14.00335, "o", "      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/05/node-0.conf\r\n      privileged: false\r\n"]
[14.003452, "o", "      state: present\r\n  + memory.value:vm-1\r\n      value: {\"name\":\"node-1\",\"port\":8001}\r\n  + host.file:cfg-1\r\n      content: <computed>\r\n      directory: false\r\n"]
[14.003476, "o", "      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/05/node-1.conf\r\n      privileged: false\r\n      state: present\r\n  + host.file:inventory\r\n      content: <computed>\r\n      directory: false\r\n      on: {\"kind\":\"local\",\"sudo\":false}\r\n      path: /tmp/ifx-lab/05/inventory.txt\r\n      privileged: false\r\n      state: present\r\n\r\nPlan: 7 to create, 0 to update, 0 to replace, 0 to delete, 0 triggered, 0 to adopt, 0 unchanged.\r\n\r\n"]
[14.117338, "o", "  create memory.value:vm-0...\r\n  create memory.value:vm-1...\r\n  create memory.value:registry...\r\n  create host.file:dir...\r\n  done memory.value:vm-0\r\n  done memory.value:vm-1\r\n  done memory.value:registry\r\n  done host.file:dir\r\n  create host.file:cfg-0...\r\n  create host.file:inventory...\r\n  create host.file:cfg-1...\r\n  done host.file:cfg-0\r\n  done host.file:inventory\r\n  done host.file:cfg-1\r\n"]
[14.124615, "o", "\r\nApply complete. 7 resource(s) changed.\r\n\r\nOutputs:\r\n"]
[14.12465, "o", "  host.file:cfg-0\r\n    exists = true\r\n    path = /tmp/ifx-lab/05/node-0.conf\r\n    sha256 = e8b69b8954b1c18440eaeca84bf203865032f7ab174ec2d5a63bed49a74ef4da\r\n  host.file:cfg-1\r\n    exists = true\r\n    path = /tmp/ifx-lab/05/node-1.conf\r\n    sha256 = 5a25ab3fb44b2e8ef22d2fe1ed8d41f7b24bad4621c3d18ef1f872e3065cc674\r\n  host.file:dir\r\n    exists = true\r\n    path = /tmp/ifx-lab/05\r\n"]
[14.12478, "o", "  host.file:inventory\r\n    exists = true\r\n    path = /tmp/ifx-lab/05/inventory.txt\r\n    sha256 = 30e04649adc554361d311bba784552a4dab9f5951e2b3bc7c4d6dc73b914ad93\r\n  memory.value:registry\r\n    id = mem-ef3c-3\r\n    value = registry.internal:5000\r\n  memory.value:vm-0\r\n    id = mem-0a19-1\r\n"]
[14.124855, "o", "    value = {\"name\":\"node-0\",\"port\":8000}\r\n  memory.value:vm-1\r\n    id = mem-0d7b-2\r\n    value = {\"name\":\"node-1\",\"port\":8001}\r\n"]
[16.928228, "o", "\r\n# A second plan is empty: the deployment is idempotent.\r\n"]
[18.328355, "o", "$ ifx plan\r\n"]
[18.983399, "o", "\r\nPlan: 0 to create, 0 to update, 0 to replace, 0 to delete, 0 triggered, 0 to adopt, 7 unchanged.\r\n"]
[21.786828, "o", "\r\n# Destroy removes managed resources in reverse dependency order.\r\n"]
[23.187006, "o", "$ ifx destroy -y\r\n"]
[23.831681, "o", "  - host.file:inventory\r\n  - host.file:cfg-1\r\n  - memory.value:vm-1\r\n  - host.file:cfg-0\r\n  - memory.value:vm-0\r\n  - memory.value:registry\r\n  - host.file:dir\r\n\r\nPlan: 0 to create, 0 to update, 0 to replace, 7 to delete, 0 triggered, 0 to adopt, 0 unchanged.\r\n\r\n"]
[23.943665, "o", "  delete host.file:inventory...\r\n  done host.file:inventory\r\n  delete host.file:cfg-1...\r\n  done host.file:cfg-1\r\n  delete memory.value:vm-1...\r\n  done memory.value:vm-1\r\n"]
[24.052797, "o", "  delete host.file:cfg-0...\r\n  done host.file:cfg-0\r\n  delete memory.value:vm-0...\r\n  done memory.value:vm-0\r\n  delete memory.value:registry...\r\n  done memory.value:registry\r\n  delete host.file:dir...\r\n  done host.file:dir\r\n"]
[24.062901, "o", "\r\nApply complete. 7 resource(s) changed.\r\n"]
[26.883831, "o", "ifx-labs: all commands exited as expected\r\n"]
