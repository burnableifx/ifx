// Executable authoring MVP: ifx/0.2-draft. Requires the accompanying Ifx.toml.
// Constructing data has no graph effect and needs no infrastructure key.
pub struct Settings {
    pub name: String,
    pub region: String = "us-east",
}

impl Settings {
    pub fn new(name: String, region: String = "us-east") -> Self {
        return Self { name: name, region: region };
    }

    pub fn description(self) -> String {
        return self.name + " in " + self.region;
    }
}

fn label(prefix: String, suffix: String) -> String {
    return prefix + "-" + suffix;
}

pub struct ValuesOutputs {
    pub description: String,
}

fn main() -> ValuesOutputs {
    let name = label("production", "web");
    let direct = Settings { name: name };
    let constructed = Settings::new()
        .name(name)
        .region(direct.region);

    return ValuesOutputs { description: constructed.description() };
}
