// Executable authoring MVP: ifx/0.2-draft. Requires the accompanying Ifx.toml.
use shared::web::WebServer;

pub struct Application {
    pub web: WebServer,
    pub website_url: String,
}

impl Application {
    pub fn new(name: String, region: String = "us-east") -> Self {
        let web = WebServer::new()
            .key("web")
            .name(name + "-web")
            .region(region);

        return Self {
            web: web,
            website_url: web.website_url,
        };
    }
}
